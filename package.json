{
  "name": "bndz",
  "private": true,
  "version": "1.0.0",
  "description": "BNDZ File Manager for Windows",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/audit-bndzui.mjs && node scripts/prebuild-icons.mjs && node scripts/copy-legal-docs.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:backend": "dotnet build BNDZBackend/BNDZ.csproj -c Release -p:EnableWindowsTargeting=true",
    "verify": "npm run lint && npm run test:unit && npm run build && npm run build:backend",
    "build:launcher": "npm run build:launcher --prefix packages/bndz-launcher",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1 -SelfContained",
    "package:rust": "powershell -ExecutionPolicy Bypass -File scripts/stage-rust-sidecars.ps1 -RequireSpacedrive -RequireSpacebot",
    "package:rust:stage": "powershell -ExecutionPolicy Bypass -File scripts/stage-rust-sidecars.ps1 -RequireSpacedrive -RequireSpacebot",
    "package:rust:source": "powershell -ExecutionPolicy Bypass -File scripts/build-rust-sidecars.ps1",
    "package:rust:source:web": "powershell -ExecutionPolicy Bypass -File scripts/build-rust-sidecars.ps1 -BuildSpacedriveWeb",
    "package:launcher": "powershell -ExecutionPolicy Bypass -File packages/bndz-launcher/scripts/build-launcher-release.ps1",
    "package:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1 -SelfContained -BuildInstaller",
    "package:installer:rust": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1 -SelfContained -BuildInstaller -RequireRustSidecars",
    "package:installer:rust:source": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1 -SelfContained -BuildInstaller -BuildRustSidecars -BuildSpacedriveWeb",
    "package:signed": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1 -SelfContained -BuildInstaller -Sign",
    "package:verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-release.ps1 -RequireInstaller",
    "license:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-license.ps1",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "audit:ui": "node scripts/audit-bndzui.mjs",
    "smoke": "node scripts/smoke-matrix.mjs",
    "audit:wiring": "node scripts/wiring-audit.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "tsx scripts/test-interaction.mjs && tsx scripts/test-storage-organize.mjs && tsx scripts/test-index-finding.mjs && tsx scripts/test-context-menu-dismiss.mjs && tsx scripts/test-tag-utils.mjs && tsx scripts/test-panel-typography.mjs && tsx scripts/test-plugin-registry.mjs && tsx scripts/test-metadata-columns.mjs && tsx scripts/test-tooltip-settings.mjs && tsx scripts/test-slow-double-click-rename.mjs && tsx scripts/test-html-preview.ts && tsx scripts/test-type-ahead-find.ts && tsx scripts/test-shell-paths.ts && tsx scripts/test-list-row-hit-targets.ts && tsx scripts/test-drop-destination.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.14.2",
    "@vitejs/plugin-react": "^5.0.4",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fuse.js": "^7.4.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.1",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
