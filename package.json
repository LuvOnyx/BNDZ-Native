{
  "name": "bndz",
  "private": true,
  "version": "1.0.0",
  "description": "BNDZ File Manager for Windows",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "package:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1 -BuildInstaller",
    "package:signed": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1 -BuildInstaller -Sign",
    "package:verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-release.ps1 -RequireInstaller",
    "license:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-license.ps1",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.14.2",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fuse.js": "^7.4.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.0.1",
    "react-resizable-panels": "^4.11.2",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
