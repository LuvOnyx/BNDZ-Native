<Window
    x:Class="BNDZShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bndz="using:BNDZShell.Bndz"
    Title="BNDZ">

    <!-- Transparent root so Mica / Acrylic SystemBackdrop paints through chrome edges. -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <bndz:CraftPaneHost x:Name="ChromeHost" Pane="browser" />
        <bndz:NativeListHost x:Name="NativeList" Visibility="Collapsed" IsHitTestVisible="False" />
        <!-- Real TermControl overlay — positioned over React Remote terminal hole. -->
        <bndz:NativeTerminalHost x:Name="NativeTerminal" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Window>
