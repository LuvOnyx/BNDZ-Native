<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- x64 + ARM64 side-by-side for modern Windows devices -->
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Keep AssemblyName distinct from BNDZBackend/BNDZ.csproj (NuGet ambiguous name).
         Product metadata + post-build BNDZ.exe alias = user-facing "BNDZ". -->
    <AssemblyName>BNDZShell</AssemblyName>
    <Product>BNDZ</Product>
    <AssemblyTitle>BNDZ</AssemblyTitle>
    <AssemblyProduct>BNDZ</AssemblyProduct>
    <Description>BNDZ</Description>
    <!-- Unpackaged self-contained: launch via BNDZ.exe alias (or BNDZShell.exe). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RootNamespace>BNDZShell</RootNamespace>
    <ApplicationIcon>..\..\..\BNDZBackend\Assets\BNDZ.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <!-- BNDZCore may carry a WebView2.Core.dll copy; WinUI package also brings one â€” allow publish. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <!-- Prefer Segoe UI Variable / Fluent type ramp in generated XAML. -->
    <WinUISDKReferences>true</WinUISDKReferences>
  </PropertyGroup>

  <!-- ReadyToRun + PGO: native-feeling startup without full Native AOT (blocked by WPF headless core). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <OptimizationPreference>Speed</OptimizationPreference>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <!--
    Native AOT: enable with -p:EnableNativeAot=true once BNDZCore is free of WPF/WinForms.
    Today the embedded backend ProjectReference is not AOT-safe; R2R is the production path.
  -->
  <PropertyGroup Condition="'$(EnableNativeAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EasyWindowsTerminalControl.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Vanara.Windows.Shell" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" />
    <PackageReference Include="CommunityToolkit.WinUI.Behaviors" />
    <PackageReference Include="CommunityToolkit.WinUI.Helpers" />
    <PackageReference Include="CommunityToolkit.WinUI.Animations" />
    <PackageReference Include="CommunityToolkit.WinUI.Media" />
    <PackageReference Include="CommunityToolkit.WinUI.Converters" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="WinUIEx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BNDZBackend\BNDZ.csproj" AdditionalProperties="ReferenceAssemblyName=BNDZCore" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\BNDZBackend\Assets\BNDZ.ico" Link="Assets\BNDZ.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.scale-*.png" />
    <Content Include="..\..\..\BNDZBackend\Assets\ui\**\*">
      <Link>Assets\ui\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Embedded backend is a DLL only â€” drop WPF WebView2 + stray host exe from output. -->
  <Target Name="StripEmbeddedBackendArtifacts" AfterTargets="CopyFilesToOutputDirectory">
    <Delete Files="$(OutputPath)BNDZCore.exe;$(OutputPath)BNDZCore.runtimeconfig.json;$(OutputPath)Microsoft.Web.WebView2.Wpf.dll;$(OutputPath)Microsoft.Web.WebView2.Wpf.xml" ContinueOnError="true" />
  </Target>

  <!--
    User-facing exe is BNDZ.exe. AssemblyName stays BNDZShell (NuGet clash with BNDZ.csproj).
    CRITICAL:
      1) Copy the apphost .exe, never $(TargetPath) â€” TargetPath is often the managed .dll.
      2) Also alias {AssemblyName}.pri â†’ BNDZ.pri. WinUI MRT resolves resources by exe basename;
         without BNDZ.pri, BNDZ.exe crashes in Microsoft.UI.Xaml.dll (0xc000027b) while
         BNDZShell.exe boots fine from the same folder.
  -->
  <Target Name="AliasProductExeAsBndz" AfterTargets="Build">
    <PropertyGroup>
      <_BndzShellAppHost>$(TargetDir)$(AssemblyName).exe</_BndzShellAppHost>
      <_BndzProductExe>$(TargetDir)BNDZ.exe</_BndzProductExe>
      <_BndzShellPdb>$(TargetDir)$(AssemblyName).pdb</_BndzShellPdb>
      <_BndzShellPri>$(TargetDir)$(AssemblyName).pri</_BndzShellPri>
    </PropertyGroup>
    <Error Text="BNDZShell apphost missing: $(_BndzShellAppHost)" Condition="!Exists('$(_BndzShellAppHost)')" />
    <Error Text="BNDZShell.pri missing (WinUI resources): $(_BndzShellPri)" Condition="!Exists('$(_BndzShellPri)')" />
    <Copy SourceFiles="$(_BndzShellAppHost)" DestinationFiles="$(_BndzProductExe)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(_BndzShellPri)" DestinationFiles="$(TargetDir)BNDZ.pri" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(_BndzShellPdb)" DestinationFiles="$(TargetDir)BNDZ.pdb" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="Exists('$(_BndzShellPdb)')" />
  </Target>

  <!-- Unpackaged WinUI: TermControl native must sit next to the exe or LoadLibrary fails (empty COMException). -->
  <Target Name="CopyTerminalNativesToOutput" AfterTargets="Build">
    <PropertyGroup>
      <_TermRid Condition="'$(Platform)' == 'ARM64' or '$(Platform)' == 'arm64'">win-arm64</_TermRid>
      <_TermRid Condition="'$(_TermRid)' == ''">win-x64</_TermRid>
      <_ConPtyRid Condition="'$(Platform)' == 'ARM64' or '$(Platform)' == 'arm64'">win10-arm64</_ConPtyRid>
      <_ConPtyRid Condition="'$(_ConPtyRid)' == ''">win10-x64</_ConPtyRid>
    </PropertyGroup>
    <ItemGroup>
      <_TermNative Include="$(OutputPath)runtimes\$(_TermRid)\native\Microsoft.Terminal.Control.dll" Condition="Exists('$(OutputPath)runtimes\$(_TermRid)\native\Microsoft.Terminal.Control.dll')" />
      <_TermNative Include="$(OutputPath)runtimes\$(_ConPtyRid)\native\conpty.dll" Condition="Exists('$(OutputPath)runtimes\$(_ConPtyRid)\native\conpty.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_TermNative)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_TermNative)' != ''" />
  </Target>
</Project>
