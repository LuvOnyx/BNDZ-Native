<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BNDZ.NativeShell.Host</RootNamespace>
    <AssemblyName>BNDZ.NativeShell.Host</AssemblyName>
    <ApplicationIcon Condition="Exists('..\BNDZBackend\Assets\BNDZ.ico')">..\BNDZBackend\Assets\BNDZ.ico</ApplicationIcon>
    <Product>BNDZ Native Shell Launcher</Product>
    <Description>Launches full BNDZ with --native-shell for side-by-side compare against classic.</Description>
    <Platforms>AnyCPU</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
