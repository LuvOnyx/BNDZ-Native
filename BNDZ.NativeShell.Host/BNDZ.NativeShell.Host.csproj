<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BNDZ.NativeShell.Host</RootNamespace>
    <AssemblyName>BNDZ.NativeShell.Host</AssemblyName>
    <ApplicationIcon Condition="Exists('..\BNDZBackend\Assets\BNDZ.ico')">..\BNDZBackend\Assets\BNDZ.ico</ApplicationIcon>
    <Product>BNDZ Native Shell (Spike)</Product>
    <Description>Files-like native WPF shell for BNDZ — no WebView2. Comparison host while WinUI destination lands.</Description>
    <Platforms>AnyCPU</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BNDZ.NativeShell.Core\BNDZ.NativeShell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
