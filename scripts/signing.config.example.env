# Copy to signing.config.env (gitignored) and fill in on your Windows release machine.
# Load before signing:  Get-Content .\scripts\signing.config.env | ForEach-Object { ... }
# Or set these in System Environment Variables / CI secrets.
#
# Cursor Origin does NOT provide these values — Origin uses Ed25519 keys for Git/API auth only.

# --- Option A: Azure Trusted Signing (recommended for indie retail) ---
# Create account: Azure Portal → Trusted Signing / Artifact Signing
# Docs: https://learn.microsoft.com/en-us/azure/trusted-signing/
# BNDZ_AZURE_SIGNING_ENDPOINT=https://eus.codesigning.azure.net/
# BNDZ_AZURE_SIGNING_ACCOUNT=YourSigningAccountName
# BNDZ_AZURE_SIGNING_PROFILE=YourCertificateProfileName
# BNDZ_AZURE_CREDENTIAL_TYPE=azure-cli
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- Option B: Traditional OV/EV certificate ---
# BNDZ_SIGN_CERT_THUMBPRINT=abcdef0123456789...
# BNDZ_SIGN_PFX_PATH=C:\secure\bndz-code-sign.pfx
# BNDZ_SIGN_PFX_PASSWORD=
