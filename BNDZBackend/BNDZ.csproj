<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BNDZ</RootNamespace>
    <AssemblyName Condition="'$(ReferenceAssemblyName)' != ''">$(ReferenceAssemblyName)</AssemblyName>
    <AssemblyName Condition="'$(ReferenceAssemblyName)' == ''">BNDZ</AssemblyName>
    <ApplicationIcon Condition="Exists('Assets\BNDZ.ico')">Assets\BNDZ.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>BNDZ File Manager</Product>
    <Company>BNDZ</Company>
    <Description>Modern Windows file manager with WebView2 UI</Description>
    <!-- Never compile/copy outputs nested under the project (verify builds, stale -o dirs). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);_build_verify_out\**;_build*\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="'$(ReferenceAssemblyName)' != ''">
    <PackageReference Update="Microsoft.Web.WebView2" ExcludeAssets="runtime;native;contentfiles;buildTransitive" PrivateAssets="all" />
  </ItemGroup>

  <!-- BNDZShell in-process: library brain only — no WPF Application / MainWindow / App.xaml. -->
  <PropertyGroup Condition="'$(ReferenceAssemblyName)' != ''">
    <OutputType>Library</OutputType>
    <DefineConstants>$(DefineConstants);BNDZ_HEADLESS_CORE</DefineConstants>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup Condition="'$(ReferenceAssemblyName)' != ''">
    <ApplicationDefinition Remove="App.xaml" />
    <Page Remove="MainWindow.xaml" />
    <Page Remove="**\*.xaml" />
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="Services\BndzFileManagerIpcService.cs" />
    <Compile Remove="Services\BndzBackendHostIpcService.cs" />
  </ItemGroup>
  <!-- Classic WPF product keeps MainWindow brain; headless host is shell-only. -->
  <ItemGroup Condition="'$(ReferenceAssemblyName)' == ''">
    <Compile Remove="Services\BndzIpcHost.cs" />
    <Compile Remove="Services\App.Headless.cs" />
  </ItemGroup>

  <!-- Headless: strip WebView2 payloads so BNDZShell MSIX does not see duplicate Core.dll. -->
  <Target Name="StripHeadlessWebView2Outputs" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(ReferenceAssemblyName)' != ''">
    <ItemGroup>
      <_Wv2Junk Include="$(OutputPath)Microsoft.Web.WebView2.*.dll" />
      <_Wv2Junk Include="$(OutputPath)Microsoft.Web.WebView2.*.xml" />
      <_Wv2Junk Include="$(OutputPath)runtimes\**\WebView2Loader.dll" />
    </ItemGroup>
    <Delete Files="@(_Wv2Junk)" ContinueOnError="true" />
  </Target>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--
    Retail secrets for Release:
    - scripts/build-release.ps1 writes LicenseSecretEmbedded.Release.cs from BNDZ_LICENSE_SECRET
    - scripts/build-release.ps1 writes LicenseTokenSecretEmbedded.Release.cs from BNDZ_TOKEN_HMAC_SECRET
    - Debug keeps empty embeds (dev defaults)
  -->
  <Target Name="RequireReleaseLicenseSecret" BeforeTargets="BeforeCompile" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_ReleaseLicFile>$(MSBuildProjectDirectory)\Services\LicenseSecretEmbedded.Release.cs</_ReleaseLicFile>
      <_ReleaseTokFile>$(MSBuildProjectDirectory)\Services\LicenseTokenSecretEmbedded.Release.cs</_ReleaseTokFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ReleaseLicFile)')" Text="Release builds require Services\LicenseSecretEmbedded.Release.cs. Run scripts/build-release.ps1 with BNDZ_LICENSE_SECRET set (non-placeholder)." />
    <Error Condition="$([System.IO.File]::ReadAllText('$(_ReleaseLicFile)').Contains('CHANGE-ME'))" Text="Release license secret file still contains the development placeholder. Rotate BNDZ_LICENSE_SECRET before shipping." />
    <Error Condition="!Exists('$(_ReleaseTokFile)')" Text="Release builds require Services\LicenseTokenSecretEmbedded.Release.cs. Run scripts/build-release.ps1 with BNDZ_TOKEN_HMAC_SECRET set." />
  </Target>

  <!-- Debug uses empty embeds; Release.*.cs are written by build-release.ps1 and must not compile in Debug. -->
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <Compile Remove="Services\LicenseSecretEmbedded.Release.cs" />
    <Compile Remove="Services\LicenseTokenSecretEmbedded.Release.cs" />
  </ItemGroup>
  <!-- Release.*.cs are already in the default Compile glob; only remove Debug stubs to avoid duplicate types. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release' AND Exists('$(MSBuildProjectDirectory)\Services\LicenseSecretEmbedded.Release.cs')">
    <Compile Remove="Services\LicenseSecretEmbedded.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release' AND Exists('$(MSBuildProjectDirectory)\Services\LicenseTokenSecretEmbedded.Release.cs')">
    <Compile Remove="Services\LicenseTokenSecretEmbedded.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNetter" Version="5.4.3.1" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.410.12" />
    <PackageReference Include="BitFaster.Caching" Version="2.6.0" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="DiscUtils.Core" Version="0.16.13" />
    <PackageReference Include="DiscUtils.Fat" Version="0.16.13" />
    <PackageReference Include="DiscUtils.Iso9660" Version="0.16.13" />
    <PackageReference Include="DiscUtils.Ntfs" Version="0.16.13" />
    <PackageReference Include="DiscUtils.Udf" Version="0.16.13" />
    <PackageReference Include="DiscUtils.Vhd" Version="0.16.13" />
    <PackageReference Include="DiscUtils.Vhdx" Version="0.16.13" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="1.0.3" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" ExcludeAssets="runtime" GeneratePathProperty="true" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Meziantou.Framework.Win32.ChangeJournal" Version="3.2.16" />
    <PackageReference Include="Meziantou.Framework.Win32.Jobs" Version="3.4.5" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Force patched native SQLite (GHSA-2m69-gcr7-jv3q; Microsoft.Data.Sqlite still pins 2.1.11). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.11" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NHotkey.Wpf" Version="3.0.0" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
    <PackageReference Include="PdfPig" Version="0.1.12" />
    <PackageReference Include="PhotoSauce.MagicScaler" Version="0.15.0" />
    <PackageReference Include="SharpCompress" Version="0.50.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="Squid-Box.SevenZipSharp" Version="1.6.2.24" />
    <PackageReference Include="Svg.Skia" Version="3.0.4" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.2" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.2" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="UTF.Unknown" Version="2.6.0" />
    <PackageReference Include="Zeroconf" Version="3.6.11" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Vanara.PInvoke.Ole" Version="5.0.5" />
    <PackageReference Include="Vanara.PInvoke.SearchApi" Version="5.0.5" />
    <PackageReference Include="Vanara.Windows.Shell" Version="5.0.5" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.5" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>

  <!-- Optional RAGE (.ydr/.ybn/…) mesh preview via CodeWalker.Core (cloned under external/). -->
  <PropertyGroup Condition="Exists('..\external\CodeWalker\CodeWalker.Core\CodeWalker.Core.csproj')">
    <DefineConstants>$(DefineConstants);BNDZ_HAS_CODEWALKER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('..\external\CodeWalker\CodeWalker.Core\CodeWalker.Core.csproj')">
    <ProjectReference Include="..\external\CodeWalker\CodeWalker.Core\CodeWalker.Core.csproj" />
  </ItemGroup>

  <!--
    LLamaSharp ships AVX variants with identical filenames. The .NET
    publisher otherwise flattens them and fails with NETSDK1152. Preserve the
    package's native directory hierarchy so LLamaSharp can select the correct
    CPU backend at runtime.
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="$(PkgLLamaSharp_Backend_Cpu)\runtimes\win-x64\native\**\*.dll">
      <Link>runtimes\win-x64\native\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LauncherShellWindow.xaml.cs" />
    <Compile Remove="Services\BndzActivationSound.cs" />
    <Compile Remove="Services\BndzBrandingText.cs" />
    <Compile Remove="Services\BndzFlowLauncherService.cs" />
    <Compile Remove="Services\BndzGeminiClient.cs" />
    <Compile Remove="Services\BndzHostCoordinator.cs" />
    <Compile Remove="Services\BndzInstalledAppsIndex.cs" />
    <Compile Remove="Services\BndzLauncherAiChatStore.cs" />
    <Compile Remove="Services\BndzLauncherIpcService.cs" />
    <Compile Remove="Services\BndzLauncherPendingActions.cs" />
    <Compile Remove="Services\BndzLauncherSettingsBridge.cs" />
    <Compile Remove="Services\BndzLauncherShellService.cs" />
    <Compile Remove="Services\BndzNoteStore.cs" />
    <Compile Remove="Services\BndzQuickLinkStore.cs" />
    <Compile Remove="Services\BndzShellQueryClient.cs" />
    <Compile Remove="Services\BndzSnippetStore.cs" />
    <Compile Remove="Services\BndzWindowLayoutService.cs" />
    <Compile Remove="Services\FilePreviewMetaService.cs" />
    <Compile Remove="Services\LauncherCommandService.cs" />
    <Compile Remove="Services\LauncherShellBridge.cs" />
    <Compile Remove="Services\LauncherSystemCommands.cs" />
    <Compile Remove="Services\LauncherWindowCommands.cs" />
    <Compile Remove="Services\BndzShellExecute.cs" />
    <Compile Remove="Services\BndzFileManagerBridge.cs" />
    <Page Remove="LauncherShellWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Assets\BNDZLauncher\**\*" />
    <Content Remove="Assets\launcher-ui\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    Self-contained WindowsDesktop publish can overwrite NuGet Microsoft.Extensions.*
    assemblies with older shared-framework copies (9.x / 8.x). App + deps.json then
    request 10.0.0.0 and the installed exe crashes at startup. Force-correct those DLLs.
  -->
  <Target Name="RestorePublishedExtensionsAssemblies" AfterTargets="Publish">
    <PropertyGroup>
      <_DiPkg>$(NuGetPackageRoot)microsoft.extensions.dependencyinjection\10.0.11\lib\net8.0</_DiPkg>
      <_DiAbsPkg>$(NuGetPackageRoot)microsoft.extensions.dependencyinjection.abstractions\10.0.11\lib\net8.0</_DiAbsPkg>
      <_GlobPkg>$(NuGetPackageRoot)microsoft.extensions.filesystemglobbing\10.0.11\lib\net8.0</_GlobPkg>
    </PropertyGroup>
    <ItemGroup>
      <_ExtFix Include="$(_DiPkg)\Microsoft.Extensions.DependencyInjection.dll" Condition="Exists('$(_DiPkg)\Microsoft.Extensions.DependencyInjection.dll')" />
      <_ExtFix Include="$(_DiAbsPkg)\Microsoft.Extensions.DependencyInjection.Abstractions.dll" Condition="Exists('$(_DiAbsPkg)\Microsoft.Extensions.DependencyInjection.Abstractions.dll')" />
      <_ExtFix Include="$(_GlobPkg)\Microsoft.Extensions.FileSystemGlobbing.dll" Condition="Exists('$(_GlobPkg)\Microsoft.Extensions.FileSystemGlobbing.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExtFix)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" Condition="'@(_ExtFix)' != ''" />
    <Warning Text="Publish Extensions restore skipped — NuGet package layout missing under $(NuGetPackageRoot)." Condition="'@(_ExtFix)' == ''" />
  </Target>


  <!--
    7z.dll staging (Wave 4 — SevenZipSharp).
    SevenZipSharp is a managed wrapper; it needs the native 7z.dll at runtime.
    The DLL is NOT bundled in the NuGet package — it ships with 7-Zip.
    Sources checked in order:
      1. Already present in output directory (manual drop-in / CI artifact).
      2. 7-Zip installed in Program Files (x64 host → x64 DLL).
      3. FilesMerge build output (if sibling repo is built).
    The runtime C# discovery in ArchiveService.cs uses the same search order.
  -->
  <Target Name="Stage7zDll" AfterTargets="Build">
    <PropertyGroup>
      <_7zPF64>$(PROGRAMW6432)\7-Zip\7z.dll</_7zPF64>
      <_7zPF86>$(ProgramFiles(x86))\7-Zip\7z.dll</_7zPF86>
      <!-- FilesMerge sibling repo typical Debug output -->
      <_7zFilesMerge>$(MSBuildProjectDirectory)\..\FilesMerge\src\Files.App\bin\x64\Debug\net8.0-windows10.0.19041.0\7z.dll</_7zFilesMerge>
    </PropertyGroup>
    <!-- Only copy if not already in output to avoid overwriting a newer manual drop -->
    <Copy SourceFiles="$(_7zPF64)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="!Exists('$(OutputPath)7z.dll') AND Exists('$(_7zPF64)')" />
    <Copy SourceFiles="$(_7zPF86)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="!Exists('$(OutputPath)7z.dll') AND !Exists('$(_7zPF64)') AND Exists('$(_7zPF86)')" />
    <Copy SourceFiles="$(_7zFilesMerge)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="!Exists('$(OutputPath)7z.dll') AND !Exists('$(_7zPF64)') AND !Exists('$(_7zPF86)') AND Exists('$(_7zFilesMerge)')" />
  </Target>

</Project>
