<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BNDZ</RootNamespace>
    <AssemblyName>BNDZ</AssemblyName>
    <ApplicationIcon Condition="Exists('Assets\BNDZ.ico')">Assets\BNDZ.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>BNDZ File Manager</Product>
    <Company>BNDZ</Company>
    <Description>Modern Windows file manager with WebView2 UI</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--
    Retail secrets for Release:
    - scripts/build-release.ps1 writes LicenseSecretEmbedded.Release.cs from BNDZ_LICENSE_SECRET
    - scripts/build-release.ps1 writes LicenseTokenSecretEmbedded.Release.cs from BNDZ_TOKEN_HMAC_SECRET
    - Debug keeps empty embeds (dev defaults)
  -->
  <Target Name="RequireReleaseLicenseSecret" BeforeTargets="BeforeCompile" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_ReleaseLicFile>$(MSBuildProjectDirectory)\Services\LicenseSecretEmbedded.Release.cs</_ReleaseLicFile>
      <_ReleaseTokFile>$(MSBuildProjectDirectory)\Services\LicenseTokenSecretEmbedded.Release.cs</_ReleaseTokFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ReleaseLicFile)')" Text="Release builds require Services\LicenseSecretEmbedded.Release.cs. Run scripts/build-release.ps1 with BNDZ_LICENSE_SECRET set (non-placeholder)." />
    <Error Condition="$([System.IO.File]::ReadAllText('$(_ReleaseLicFile)').Contains('CHANGE-ME'))" Text="Release license secret file still contains the development placeholder. Rotate BNDZ_LICENSE_SECRET before shipping." />
    <Error Condition="!Exists('$(_ReleaseTokFile)')" Text="Release builds require Services\LicenseTokenSecretEmbedded.Release.cs. Run scripts/build-release.ps1 with BNDZ_TOKEN_HMAC_SECRET set." />
  </Target>

  <!-- Debug uses empty embeds; Release.*.cs are written by build-release.ps1 and must not compile in Debug. -->
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <Compile Remove="Services\LicenseSecretEmbedded.Release.cs" />
    <Compile Remove="Services\LicenseTokenSecretEmbedded.Release.cs" />
  </ItemGroup>
  <!-- Release.*.cs are already in the default Compile glob; only remove Debug stubs to avoid duplicate types. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release' AND Exists('$(MSBuildProjectDirectory)\Services\LicenseSecretEmbedded.Release.cs')">
    <Compile Remove="Services\LicenseSecretEmbedded.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release' AND Exists('$(MSBuildProjectDirectory)\Services\LicenseTokenSecretEmbedded.Release.cs')">
    <Compile Remove="Services\LicenseTokenSecretEmbedded.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.410.12" />
    <PackageReference Include="BitFaster.Caching" Version="2.6.0" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" ExcludeAssets="runtime" GeneratePathProperty="true" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Meziantou.Framework.Win32.Jobs" Version="3.4.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.0" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NHotkey.Wpf" Version="3.0.0" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
    <PackageReference Include="SharpCompress" Version="0.50.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="Svg.Skia" Version="3.0.4" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.2" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
    <PackageReference Include="SIPSorcery" Version="8.0.23" />
    <PackageReference Include="Zeroconf" Version="3.6.11" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Vanara.PInvoke.SearchApi" Version="5.0.5" />
    <PackageReference Include="Vanara.Windows.Shell" Version="5.0.5" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>

  <!--
    LLamaSharp ships AVX variants with identical filenames. The .NET
    publisher otherwise flattens them and fails with NETSDK1152. Preserve the
    package's native directory hierarchy so LLamaSharp can select the correct
    CPU backend at runtime.
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="$(PkgLLamaSharp_Backend_Cpu)\runtimes\win-x64\native\**\*.dll">
      <Link>runtimes\win-x64\native\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LauncherShellWindow.xaml.cs" />
    <Compile Remove="Services\BndzActivationSound.cs" />
    <Compile Remove="Services\BndzBrandingText.cs" />
    <Compile Remove="Services\BndzFlowLauncherService.cs" />
    <Compile Remove="Services\BndzGeminiClient.cs" />
    <Compile Remove="Services\BndzHostCoordinator.cs" />
    <Compile Remove="Services\BndzInstalledAppsIndex.cs" />
    <Compile Remove="Services\BndzLauncherAiChatStore.cs" />
    <Compile Remove="Services\BndzLauncherIpcService.cs" />
    <Compile Remove="Services\BndzLauncherPendingActions.cs" />
    <Compile Remove="Services\BndzLauncherSettingsBridge.cs" />
    <Compile Remove="Services\BndzLauncherShellService.cs" />
    <Compile Remove="Services\BndzNoteStore.cs" />
    <Compile Remove="Services\BndzQuickLinkStore.cs" />
    <Compile Remove="Services\BndzShellQueryClient.cs" />
    <Compile Remove="Services\BndzSnippetStore.cs" />
    <Compile Remove="Services\BndzWindowLayoutService.cs" />
    <Compile Remove="Services\FilePreviewMetaService.cs" />
    <Compile Remove="Services\LauncherCommandService.cs" />
    <Compile Remove="Services\LauncherShellBridge.cs" />
    <Compile Remove="Services\LauncherSystemCommands.cs" />
    <Compile Remove="Services\LauncherWindowCommands.cs" />
    <Compile Remove="Services\BndzShellExecute.cs" />
    <Compile Remove="Services\BndzFileManagerBridge.cs" />
    <Page Remove="LauncherShellWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Assets\BNDZLauncher\**\*" />
    <Content Remove="Assets\launcher-ui\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
