<Window x:Class="BNDZ.LauncherShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="BNDZ Launcher"
        Width="680"
        Height="56"
        MinWidth="480"
        MinHeight="56"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#FF1C1C20"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="True">
    <Border CornerRadius="14" Background="#FF1C1C20" ClipToBounds="True" Padding="0">
        <wv2:WebView2 x:Name="LauncherWebView"
                      DefaultBackgroundColor="Transparent"
                      Focusable="True" />
    </Border>
</Window>
