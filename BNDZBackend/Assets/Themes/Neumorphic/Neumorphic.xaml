                        </Grid.Effect>
                        <!--<Rectangle
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Fill="#e3e3e3"
                                        Margin="0"
                                        RadiusX="8"
                                        RadiusY="8">-->

                        <!--<Rectangle.Effect>
                                <WPF_Neumorphism_Plus:Neumorphism_Plus_Shader
                                            BlurRadius="5"
                                            BorderRadius="4"
                                            Inset="0"
                                            OffsetX="5"
                                            OffsetY="5"
                                            PrimaryColor="Silver"
                                            SecondaryColor="WhiteSmoke"
