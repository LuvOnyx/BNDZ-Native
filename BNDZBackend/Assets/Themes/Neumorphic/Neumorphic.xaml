        <Setter Property="Margin" Value="4" />
        <Setter Property="Effect">
            <Setter.Value>
                <WPF_Neumorphism_Plus:Neumorphism_Plus_Shader
                    BlurRadius="2"
                    BorderRadius="4"
                    Inset="0"
                    OffsetX="2"
                    OffsetY="2"
                    PrimaryColor="Silver"
                    SecondaryColor="WhiteSmoke"
                    SpreadRadius="2" />
            </Setter.Value>
        </Setter>
    </Style>

