    <Style x:Key="BorderNeuOut" TargetType="Border">
        <!--<Setter Property="Background" Value="#e3e3e3"/>-->
        <Setter Property="Background">
            <Setter.Value>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Control
                            Width="100"
                            Height="100"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            BorderThickness="1"
