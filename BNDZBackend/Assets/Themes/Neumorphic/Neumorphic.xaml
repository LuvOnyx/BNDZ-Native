    <Style TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource ButtonMinSize}" />
        <Setter Property="MinHeight" Value="{StaticResource ButtonMinSize}" />
        <Setter Property="Margin" Value="4,0,4,0" />
        <Setter Property="Padding" Value="4,0,4,0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}" />
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,.2" EndPoint="0,.9">
                    <GradientStop Offset="0" Color="#e9e9e9" />
                    <GradientStop Offset="1" Color="#d1d1d1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid
                            Margin="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ClipToBounds="False">
                            <Grid.Effect>
                                <WPF_Neumorphism_Plus:Neumorphism_Plus_Shader
                                    x:Name="shader"
                                    BlurRadius="2"
                                    BorderRadius="4"
                                    OffsetX="2"
                                    OffsetY="2"
                                    PrimaryColor="Silver"
                                    SecondaryColor="WhiteSmoke"
                                    SpreadRadius="2" />

                            </Grid.Effect>
                            <Rectangle Margin="1" Fill="Transparent" />
                        </Grid>
                        <Rectangle
                            x:Name="bck"
                            Margin="0"
                            Fill="{TemplateBinding Background}"
                            RadiusX="4"
                            RadiusY="4" />

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />

                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#cccccc" />
                                        <GradientStop Offset="1" Color="#eeeeee" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!--<Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="buttonGrid" Property="ClipToBounds" Value="True" />
                                </Trigger>-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Margin="-1">
                                <Grid.Effect>
                                    <WPF_Neumorphism_Plus:Neumorphism_Plus_Shader
                                        BlurRadius="4"
                                        BorderRadius="4"
                                        Inset="1"
                                        OffsetX="2"
                                        OffsetY="2"
                                        PrimaryColor="Silver"
                                        SecondaryColor="WhiteSmoke"
                                        SpreadRadius="0" />
                                </Grid.Effect>
                                <Rectangle
                                    Fill="{TemplateBinding Background}"
                                    RadiusX="4"
                                    RadiusY="4" />
                                <Rectangle
                                    Margin="3"
                                    RadiusX="2"
                                    RadiusY="4">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#cccccc" />
                                            <GradientStop Offset="1" Color="#eeeeee" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
