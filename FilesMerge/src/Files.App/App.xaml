<Application
	x:Class="Files.App.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:uc="using:Files.App.UserControls">

	<Application.Resources>
		<ResourceDictionary>

			<x:Boolean x:Key="App.ScrollInertiaEnabled">True</x:Boolean>

			<!--  Fix caption buttons background  -->
			<SolidColorBrush x:Key="WindowCaptionBackground" Color="Transparent" />
			<SolidColorBrush x:Key="WindowCaptionBackgroundDisabled" Color="Transparent" />

			<!--  Workaround for https://github.com/microsoft/microsoft-ui-xaml/issues/5441  -->
			<x:Double x:Key="MediaTransportControlsMinWidth">50</x:Double>

			<!--  Workaround for an issue where the shadow was showing on the tab control  -->
			<x:Double x:Key="TabViewShadowDepth">0</x:Double>

			<CornerRadius x:Key="GridViewThumbnailCornerRadius">2</CornerRadius>
			<CornerRadius x:Key="DetailsLayoutThumbnailCornerRadius">2</CornerRadius>

			<!--  Workaround for https://github.com/files-community/Files/issues/13078  -->
			<Style TargetType="FlyoutPresenter">
				<Setter Target="HighContrastAdjustment" Value="None" />
				<Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
			</Style>

			<Style TargetType="MenuFlyoutPresenter">
				<Setter Target="HighContrastAdjustment" Value="None" />
			</Style>


			<!--  Workaround for https://github.com/files-community/Files/issues/12026  -->
			<Style BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}" TargetType="MenuFlyoutItem">
				<Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
			</Style>

			<!--  Workaround for https://github.com/files-community/Files/issues/12026  -->
			<Style BasedOn="{StaticResource DefaultToggleMenuFlyoutItemStyle}" TargetType="ToggleMenuFlyoutItem">
				<Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
			</Style>

			<!--  Workaround for https://github.com/files-community/Files/issues/12026  -->
			<Style BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}" TargetType="MenuFlyoutSubItem">
				<Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
			</Style>

			<Style BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="uc:ComboBoxEx" />

			<Style TargetType="ScrollViewer">
				<Setter Property="IsScrollInertiaEnabled" Value="{ThemeResource App.ScrollInertiaEnabled}" />
			</Style>

			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
				<ResourceDictionary Source="ms-appx:///Files.App.Controls/Themes/Generic.xaml" />

				<!--  Styles for the custom icons  -->
				<ResourceDictionary Source="ms-appx:///Styles/PathIcons.xaml" />
				<ResourceDictionary Source="ms-appx:///Styles/TextBlockStyles.xaml" />
				<ResourceDictionary Source="ms-appx:///Styles/ShimmerStyles.xaml" />
				<ResourceDictionary Source="ms-appx:///Styles/MenuFlyoutSubItemWithImageStyle.xaml" />
				<ResourceDictionary Source="ms-appx:///Styles/BndzTheme.xaml" />
				<ResourceDictionary>
					<ResourceDictionary.ThemeDictionaries>
						<ResourceDictionary x:Key="Light">
							<!-- Soft BNDZ bleed into light Files chrome (list/tree engines keep Files). -->
							<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="#F0E8EEF4" />
							<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="#E6F2F6FA" />
							<SolidColorBrush x:Key="App.Theme.Sidebar.BackgroundBrush" Color="#F4EEF2F6" />
							<SolidColorBrush x:Key="App.Theme.FileArea.BackgroundBrush" Color="#F8FAFC" />
							<SolidColorBrush x:Key="App.Theme.FileArea.SecondaryBackgroundBrush" Color="#EEF2F6" />
							<SolidColorBrush x:Key="App.Theme.InfoPane.BackgroundBrush" Color="#F0F4F8" />
							<SolidColorBrush x:Key="App.Theme.StatusBar.BackgroundBrush" Color="#F0E8EEF4" />

							<SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#E6DCE6F0" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#D0C8D8E8" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#E0D8E4F0" />

							<SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#55264F78" />
							<SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#66264F78" />
							<SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#77264F78" />
							<SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#142A2D2E" />
							<SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#222A2D2E" />
							<SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#55264F78" />
							<SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#66264F78" />
							<SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#77264F78" />
							<SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#142A2D2E" />
							<SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="#222A2D2E" />
							<SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF007ACC" />

							<Color x:Key="App.Theme.FillColorAttention">#3B82C4</Color>
							<SolidColorBrush x:Key="App.Theme.FillColorAttentionBrush" Color="{StaticResource App.Theme.FillColorAttention}" />
							<SolidColorBrush x:Key="App.Theme.CardBackgroundFillColorTertiaryBrush" Color="#FFFFFFFF" />
						</ResourceDictionary>
						<ResourceDictionary x:Key="Dark">
							<!-- Official BNDZ craft on Files chrome + list/tree selection washes. -->
							<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="{StaticResource BndzSurface}" />
							<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="{StaticResource BndzSurfaceRaised}" />
							<SolidColorBrush x:Key="App.Theme.Sidebar.BackgroundBrush" Color="{StaticResource BndzSurface}" />
							<SolidColorBrush x:Key="App.Theme.FileArea.BackgroundBrush" Color="#FF0C0F14" />
							<SolidColorBrush x:Key="App.Theme.FileArea.SecondaryBackgroundBrush" Color="{StaticResource BndzSurfaceRaised}" />
							<SolidColorBrush x:Key="App.Theme.InfoPane.BackgroundBrush" Color="{StaticResource BndzSurfaceRaised}" />
							<SolidColorBrush x:Key="App.Theme.StatusBar.BackgroundBrush" Color="{StaticResource BndzSurface}" />

							<SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource BndzSurfaceRaised}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#4024475A" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#3324475A" />

							<!-- Files list engine — BNDZ selection/hover (ListView / details) -->
							<SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource BndzListSelected}" />
							<SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource BndzListSelectedHover}" />
							<SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{StaticResource BndzListSelectedStrong}" />
							<SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource BndzListHover}" />
							<SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{StaticResource BndzListHoverStrong}" />
							<SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="#80264F78" />

							<!-- Files list engine — BNDZ selection/hover (Grid / tiles) -->
							<SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="{StaticResource BndzListSelected}" />
							<SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="{StaticResource BndzListSelectedHover}" />
							<SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="{StaticResource BndzListSelectedStrong}" />
							<SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="{StaticResource BndzListHover}" />
							<SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="{StaticResource BndzListHoverStrong}" />
							<SolidColorBrush x:Key="GridViewItemBackgroundSelectedDisabled" Color="#80264F78" />

							<!-- Accent bar / focus shared with BNDZ tree indicator -->
							<SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource BndzListAccentBar}" />
							<SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{StaticResource BndzListSelected}" />
							<SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{StaticResource BndzListSelectedHover}" />

							<Color x:Key="App.Theme.FillColorAttention">#99C9F0</Color>
							<SolidColorBrush x:Key="App.Theme.FillColorAttentionBrush" Color="{StaticResource App.Theme.FillColorAttention}" />
							<SolidColorBrush x:Key="App.Theme.CardBackgroundFillColorTertiaryBrush" Color="#12FFFFFF" />
						</ResourceDictionary>
						<ResourceDictionary x:Key="HighContrast">
							<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.Sidebar.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.FileArea.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.FileArea.SecondaryBackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.InfoPane.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.StatusBar.BackgroundBrush" Color="Transparent" />

							<SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="{StaticResource SystemColorWindowColor}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource SystemColorHighlightColor}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{StaticResource SystemColorHighlightColor}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource SystemColorHighlightColor}" />

							<Color x:Key="App.Theme.FillColorAttention">#50C0FF</Color>
							<SolidColorBrush x:Key="App.Theme.FillColorAttentionBrush" Color="{StaticResource App.Theme.FillColorAttention}" />
							<SolidColorBrush x:Key="App.Theme.CardBackgroundFillColorTertiaryBrush" Color="{StaticResource SystemColorWindowColor}" />
						</ResourceDictionary>
					</ResourceDictionary.ThemeDictionaries>
				</ResourceDictionary>
			</ResourceDictionary.MergedDictionaries>

		</ResourceDictionary>
	</Application.Resources>
</Application>
