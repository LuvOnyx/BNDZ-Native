<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="BndzBgDeep">#FF12151A</Color>
  <Color x:Key="BndzBgPanel">#FF1A1F27</Color>
  <Color x:Key="BndzAccent">#FF5B8CFF</Color>
  <SolidColorBrush x:Key="BndzBgDeepBrush" Color="{StaticResource BndzBgDeep}" />
  <SolidColorBrush x:Key="BndzBgPanelBrush" Color="{StaticResource BndzBgPanel}" />
  <SolidColorBrush x:Key="BndzAccentBrush" Color="{StaticResource BndzAccent}" />
  <CornerRadius x:Key="BndzSquircle">14</CornerRadius>

</ResourceDictionary>
