<Window
    x:Class="BNDZ.NativeShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BNDZ.NativeShell.Core.Models"
    Title="BNDZ Native Shell">

  <!-- Files-like topology (reference craft only). BNDZ 17 / 71 / 12 columns. -->
  <Grid x:Name="RootGrid" Background="{StaticResource BndzBgDeepBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="16,0">
      <TextBlock Text="BNDZ"
                 VerticalAlignment="Center"
                 Style="{StaticResource CaptionTextBlockStyle}"
                 FontWeight="SemiBold" />
    </Grid>

    <Grid Grid.Row="1" Padding="12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ListView ItemsSource="{Binding Tabs}"
                SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                SelectionMode="Single"
                Height="44">
        <ListView.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" />
          </ItemsPanelTemplate>
        </ListView.ItemsPanel>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="models:ShellTab">
            <Border Background="{StaticResource BndzBgPanelBrush}"
                    CornerRadius="{StaticResource BndzSquircle}"
                    Padding="12,8">
              <TextBlock Text="{x:Bind Title}" />
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <Button Grid.Column="1"
              Content="+ Tab"
              Command="{Binding NewTabCommand}"
              Margin="8,0,0,0" />
    </Grid>

    <Grid Grid.Row="2" Padding="12,0,12,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="↑ Up" Command="{Binding GoUpCommand}" />
      <TextBox x:Name="OmnibarTextBox"
               Grid.Column="1"
               Text="{Binding OmnibarText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               KeyDown="Omnibar_KeyDown"
               PlaceholderText="Path" />
      <Button Grid.Column="2" Content="Go" Command="{Binding SubmitOmnibarCommand}" />
    </Grid>

    <Grid Grid.Row="3" Padding="12,0" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="17*" MinWidth="180" />
        <ColumnDefinition Width="71*" MinWidth="320" />
        <ColumnDefinition Width="12*" MinWidth="160" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource BndzBgPanelBrush}"
              CornerRadius="{StaticResource BndzSquircle}"
              Padding="8">
        <ListView ItemsSource="{Binding Drives}"
                  IsItemClickEnabled="True"
                  ItemClick="DriveList_ItemClick"
                  SelectionMode="Single">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:DriveEntry">
              <StackPanel Spacing="2" Padding="4">
                <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind CapacityDisplay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Border>

      <Border Grid.Column="1"
              Background="{StaticResource BndzBgPanelBrush}"
              CornerRadius="{StaticResource BndzSquircle}"
              Padding="4">
        <ListView x:Name="FileList"
                  ItemsSource="{Binding Entries}"
                  IsItemClickEnabled="True"
                  ItemClick="FileList_ItemClick"
                  DoubleTapped="FileList_DoubleTapped"
                  SelectionMode="Single">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:FileEntry">
              <Grid Padding="8,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{x:Bind SizeDisplay}" Opacity="0.7" />
                <TextBlock Grid.Column="2" Text="{x:Bind ModifiedDisplay}" Opacity="0.7" />
                <TextBlock Grid.Column="3" Text="{x:Bind KindDisplay}" Opacity="0.7" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Border>

      <Border Grid.Column="2"
              Background="{StaticResource BndzBgPanelBrush}"
              CornerRadius="{StaticResource BndzSquircle}"
              Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="Preview" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
          <TextBlock Text="{Binding PreviewSnapshot.Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
          <TextBlock Text="{Binding PreviewSnapshot.Subtitle}" Opacity="0.7" />
          <ItemsControl ItemsSource="{Binding PreviewSnapshot.Facts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PreviewFact">
                <StackPanel Margin="0,0,0,8" Spacing="2">
                  <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                  <TextBlock Text="{x:Bind Value}" TextWrapping="WrapWholeWords" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="4" Padding="16,10">
      <TextBlock>
        <Run Text="{Binding StatusText}" />
        <Run Text="  ·  " />
        <Run Text="{Binding CurrentPath}" />
      </TextBlock>
    </Grid>
  </Grid>
</Window>
